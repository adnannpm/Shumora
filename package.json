{
  "name": "pi-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop workspace for independent Pi terminal sessions",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run release:check && npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release:check": "node scripts/release-check.mjs",
    "release:prepare": "node scripts/release-prepare.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "parse5": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "dev.piworkspace.desktop",
    "productName": "Shumora",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "third-party/**/*",
      "resources/icons/**/*"
    ],
    "extraResources": [
      { "from": "resources/meeting-extension.mjs", "to": "meeting-extension.mjs" }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "linux": {
      "icon": "resources/icons/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "nsis": { "include": "resources/windows-context-menu.nsh" },
    "artifactName": "Shumora-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "resources/icons/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "adnannpm",
        "repo": "Shumora",
        "releaseType": "release"
      }
    ]
  }
}
